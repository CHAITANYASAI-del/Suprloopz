# =============================================================================
# SuperLoopz — Vendor Onboarding  |  Environment Configuration
# Copy this file to `.env` and fill in real values before running.
#   cp .env.example .env
# =============================================================================

# ----- Postgres (also backs Keycloak) ---------------------------------------
POSTGRES_USER=superloopz
POSTGRES_PASSWORD=superloopz_dev_password
POSTGRES_DB=superloopz
KEYCLOAK_DB=keycloak
# Used by the backend. Inside docker-compose this is overridden to use the
# `postgres` service hostname; for running the backend on the host use localhost.
DATABASE_URL=postgres://superloopz:superloopz_dev_password@localhost:5432/superloopz

# ----- Redis ----------------------------------------------------------------
REDIS_PASSWORD=superloopz_redis_password
REDIS_URL=redis://:superloopz_redis_password@localhost:6379

# ----- Keycloak -------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=superloopz
# Confidential client used by the backend (admin operations + token exchange)
KEYCLOAK_CLIENT_ID=superloopz-backend
KEYCLOAK_CLIENT_SECRET=superloopz-backend-dev-secret
# Public client used by the Next.js frontend (PKCE)
KEYCLOAK_PUBLIC_CLIENT_ID=superloopz-web
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
# Keycloak master-realm admin (for the Admin REST API: create users, invites)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ----- MinIO (self-hosted, legal documents: GST / PAN / CIN) ----------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=superloopz_minio
MINIO_SECRET_KEY=superloopz_minio_password
MINIO_BUCKET_LEGAL_DOCS=superloopz-legal-docs
MINIO_REGION=us-east-1

# ----- Cloudflare R2 (managed, profile photos / catalog images) -------------
CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=replace-with-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=replace-with-r2-secret-key
CLOUDFLARE_R2_BUCKET=superloopz-public
CLOUDFLARE_R2_REGION=auto

# ----- Resend (transactional email) -----------------------------------------
RESEND_API_KEY=re_replace_with_real_key
RESEND_FROM_EMAIL=SuperLoopz <onboarding@superloopz.com>
# Public base URL of the frontend, used to build login links in emails.
# Dev: http://localhost:3001  |  Prod (Vercel): https://superloopzvendor.vercel.app
APP_BASE_URL=http://localhost:3001

# ----- App / Security -------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins for the API.
# Include the deployed frontend in production, e.g.:
#   CORS_ORIGINS=https://superloopzvendor.vercel.app
CORS_ORIGINS=http://localhost:3001,https://superloopzvendor.vercel.app
# Rate limiting (per IP, sliding window via Redis)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# ----- Frontend -------------------------------------------------------------
NEXTJS_PUBLIC_API_URL=http://localhost:3000
