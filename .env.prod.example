# =============================================================================
# SuperLoopz — PRODUCTION environment (Oracle VPS + Coolify).  Everything $0.
#
#  1. Run ./scripts/gen-secrets.sh to generate the strong secrets below.
#  2. Pick free HTTPS hostnames (no domain purchase needed) — see "DOMAINS".
#  3. Paste these into Coolify → your compose resource → Environment Variables.
#
# NEVER commit the filled-in version. This .example holds placeholders only.
# =============================================================================

# ----- DOMAINS (all free) ---------------------------------------------------
# You do NOT need to buy a domain. Two free options that work with Let's Encrypt
# (Coolify issues the certs automatically):
#   A) sslip.io  — zero signup. Uses your VPS public IP, e.g. if IP=132.145.10.20:
#        api.132-145-10-20.sslip.io   auth.132-145-10-20.sslip.io   files.132-145-10-20.sslip.io
#   B) DuckDNS   — free, nicer names: create api-superloopz / auth-superloopz / files-superloopz
#        api-superloopz.duckdns.org   auth-superloopz.duckdns.org   files-superloopz.duckdns.org
# Frontend stays on Vercel: https://superloopzvendor.vercel.app
#
# Fill these with whichever you chose (https://, no trailing slash):
KEYCLOAK_HOSTNAME=auth.<your-free-host>
KEYCLOAK_PUBLIC_URL=https://auth.<your-free-host>
MINIO_PUBLIC_URL=https://files.<your-free-host>
APP_BASE_URL=https://superloopzvendor.vercel.app
CORS_ORIGINS=https://superloopzvendor.vercel.app

# ----- Postgres (generate a strong password) --------------------------------
POSTGRES_USER=superloopz
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=superloopz
KEYCLOAK_DB=keycloak

# ----- Redis ----------------------------------------------------------------
REDIS_PASSWORD=__GENERATE__

# ----- Keycloak -------------------------------------------------------------
KEYCLOAK_REALM=superloopz
KEYCLOAK_CLIENT_ID=superloopz-backend
KEYCLOAK_CLIENT_SECRET=__GENERATE__       # also set on the superloopz-backend client in Keycloak
KEYCLOAK_PUBLIC_CLIENT_ID=superloopz-web
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__      # the Keycloak master admin — keep secret

# ----- MinIO (legal docs: GST / PAN / CIN) ----------------------------------
MINIO_ACCESS_KEY=superloopz_minio
MINIO_SECRET_KEY=__GENERATE__
MINIO_BUCKET_LEGAL_DOCS=superloopz-legal-docs

# ----- Cloudflare R2 (free 10GB — profile/catalog images) --------------------
CLOUDFLARE_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=superloopz-public

# ----- Resend (free 3K emails/month) ----------------------------------------
RESEND_API_KEY=re_your_real_key
RESEND_FROM_EMAIL=SuperLoopz <onboarding@resend.dev>

# ----- App security ---------------------------------------------------------
JWT_SECRET=__GENERATE__
