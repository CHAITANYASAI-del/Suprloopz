# Frontend (Next.js) public env vars — set these in Vercel → Project → Settings
# → Environment Variables. They are inlined at build time (NEXT_PUBLIC_*), so a
# redeploy is needed after changing them.
#
# For local dev these all default to localhost (see the values below), so you
# usually don't need this file locally.

# Public URL of the backend API (Express) — your Oracle VPS in production.
NEXT_PUBLIC_API_URL=https://api.superloopz.example

# Public URL of Keycloak — your Oracle VPS in production.
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.superloopz.example
NEXT_PUBLIC_KEYCLOAK_REALM=superloopz
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=superloopz-web
